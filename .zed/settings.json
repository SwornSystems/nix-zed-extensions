{
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,

  "file_scan_exclusions": ["**/.direnv", "**/.git"],

  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer"],
      "format_on_save": "on",
      "formatter": "language_server"
    },

    "Markdown": {
      "language_servers": ["vale", "typos"],
      "soft_wrap": "none"
    },

    "TOML": {
      "language_servers": ["tombi"],
      "format_on_save": "on",
      "formatter": "language_server"
    },

    "Nu": {
      "language_servers": ["nu", "nu-lint"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nufmt",
          "arguments": ["--stdin"]
        }
      }
    },

    "Nix": {
      "language_servers": ["nixd", "nil"],
      "format_on_save": "on",
      "formatter": "language_server"
    }
  },

  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path": "rust-analyzer"
      },

      "initialization_options": {
        "cargo": {
          "targetDir": true,
          "features": "all"
        },
        "check": {
          "command": "clippy"
        },
        "checkOnSave": true,
        "hover": {
          "memoryLayout": {
            "enable": true,
            "size": "decimal",
            "alignment": "decimal",
            "offset": "decimal",
            "niches": true
          }
        },
        "imports": {
          "prefix": "crate",
          "preferNoStd": true,
          "granularity": {
            "enforce": true,
            "group": "module"
          }
        }
      }
    },

    "typos": {
      "binary": {
        "path": "typos-lsp"
      }
    },

    "vale": {
      "binary": {
        "path": "vale-ls"
      }
    },

    "tombi": {
      "binary": {
        "path": "tombi",
        "arguments": ["lsp"]
      }
    },

    "nu": {
      "binary": {
        "path": "nu",
        "arguments": ["--lsp"]
      }
    },

    "nu-lint": {
      "binary": {
        "path": "nu-lint",
        "arguments": ["--lsp", "--config", ".nu-lint.toml"]
      }
    },

    "nixd": {
      "binary": {
        "path": "nixd"
      },

      "settings": {
        "formatting": {
          "command": ["nixfmt", "--width=120"]
        }
      }
    },

    "nil": {
      "binary": {
        "path": "nil"
      }
    }
  }
}
